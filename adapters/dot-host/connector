#!/bin/sh
# D-Bond owns this internal runtime; no external DotBridge installation is used.
set -eu
HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
STATE="${HOME}/Library/Application Support/D-Bond/Dot Connector"
if [ "${1:-}" = "--state-dir" ]; then
  STATE=$2
  shift 2
fi
COMMAND=${1:-status}
PYTHON="$STATE/runtime/bin/python3"
if [ -x "$HERE/../dot-runtime/python/bin/python3.13" ]; then
  PYTHON="$HERE/../dot-runtime/python/bin/python3.13"
fi
if [ ! -x "$PYTHON" ]; then
  case "$COMMAND" in
    configure|configure-tunnel|provision) "$HERE/provision" "$STATE" ;;
    *) printf '%s\n' '{"configured":false,"running":false,"subscribed":false,"public_url":"","redirect_uri":"","mcp_url":"","route":"owned","identity":{"connected":false,"active_subscriptions":0},"state":"not_configured","reason":"runtime_not_provisioned"}'; exit 0 ;;
  esac
fi
exec "$PYTHON" -I -B "$HERE/host.py" --state-dir "$STATE" "$@"
