{
  "description": "Remind the exact enrolled Claude Code session to restore its D-Bond Monitor",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/launch.sh"],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
