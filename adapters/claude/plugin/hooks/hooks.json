{
  "description": "Remind the exact enrolled Claude Code session to restore its D-Bond Monitor",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env",
            "args": ["python3", "${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py"],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
