{
  "manifest_version": "0.3",
  "name": "d-bond",
  "display_name": "D-Bond",
  "version": "0.1.3",
  "description": "Use one local D-Bond pairing for Dot messages and direct messages with other paired services.",
  "author": {"name": "IVG"},
  "server": {
    "type": "binary",
    "entry_point": "server/d-bond-launcher",
    "mcp_config": {
      "command": "/bin/sh",
      "args": ["${__dirname}/server/launch.sh"]
    }
  },
  "compatibility": {
    "platforms": ["darwin"]
  }
}
