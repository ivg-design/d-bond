#!/bin/sh
set -eu
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
for runtime in "$here/../../dist/D-Bond.app/Contents/Resources/dot-runtime/python/bin/python3.13" "/Applications/D-Bond.app/Contents/Resources/dot-runtime/python/bin/python3.13" "$HOME/Applications/D-Bond.app/Contents/Resources/dot-runtime/python/bin/python3.13"; do
    if [ -x "$runtime" ]; then exec "$runtime" -I -B "$here/probe.py" "$@"; fi
done
echo 'Build or install D-Bond.app with the bundled Dot runtime first.' >&2
exit 1
